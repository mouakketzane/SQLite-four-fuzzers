#
# DDFuzz image: uses the official AFL++ Docker image as the base,
# which comes with afl-clang-fast, afl-fuzz, and all LLVM tooling
# pre-built and ready to go.
#

FROM aflplusplus/aflplusplus:latest

LABEL "maintainer"="afl++ team <afl@aflplus.plus>"
LABEL "about"="DDFuzz image based on official AFL++"

ARG DEBIAN_FRONTEND=noninteractive

# Install extra tools useful for building fuzz targets
RUN apt-get update && \
    apt-get -y install --no-install-suggests --no-install-recommends \
    git cmake build-essential pkg-config \
    zlib1g-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV AFL_SKIP_CPUFREQ=1
ENV AFL_TRY_AFFINITY=1
ENV AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1
ENV IS_DOCKER="1"
